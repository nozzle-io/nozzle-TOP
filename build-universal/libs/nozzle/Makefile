	cd /Users/2bit/prog/cpp/nozzle-TOP/build-universal && $(MAKE) $(MAKESILENT) -f libs/nozzle/CMakeFiles/nozzle.dir/build.make libs/nozzle/CMakeFiles/nozzle.dir/src/common/texture.cpp.i
.PHONY : src/common/texture.cpp.i

src/common/texture.s: src/common/texture.cpp.s
.PHONY : src/common/texture.s

# target to generate assembly for a file
src/common/texture.cpp.s:
	cd /Users/2bit/prog/cpp/nozzle-TOP/build-universal && $(MAKE) $(MAKESILENT) -f libs/nozzle/CMakeFiles/nozzle.dir/build.make libs/nozzle/CMakeFiles/nozzle.dir/src/common/texture.cpp.s
.PHONY : src/common/texture.cpp.s

